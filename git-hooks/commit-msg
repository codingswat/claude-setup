#!/bin/bash
# Fires on every commit on this machine, regardless of which tool made it (an agent, a
# subagent, a background job, or you typing at the terminal) — git runs it for `git merge`
# too. Refuses a commit whose message, or whose committer identity, carries AI attribution,
# so pushed history reads as your own work.
#
# What counts, and what deliberately does not:
#   - a TRAILER naming Claude or Anthropic — any key, not just Co-Authored-By
#     (`Assisted-by: Claude Opus 5` is the same claim wearing a different hat). A trailer
#     is a `Key: value` line in the message's LAST paragraph, and only when that paragraph
#     is not also the first one. Prose is not a trailer: a subject line such as
#     `docs: explain why we never add Co-Authored-By: Claude lines` is a sentence ABOUT
#     the rule and passes.
#   - the generated-with signature line, matched by its own shape (`Generated with Claude
#     Code` or `Generated with [Claude Code]`), wherever it sits — so a subject such as
#     "room labels generated with the Claude API" (a tool the work used) passes;
#   - `noreply@anthropic.com` anywhere in the message;
#   - the COMMITTER identity (`git var GIT_COMMITTER_IDENT`) naming Claude or Anthropic —
#     `GIT_COMMITTER_NAME=Claude git commit` writes that name into the commit object even
#     when the author line is yours. No readable committer identity: that half is skipped.
#   - a name from $HOME/.claude/.redaction-names.local typed into the MESSAGE (pre-commit only
#     reads staged content). Same list format as pre-commit: `word:` prefix, and an entry
#     under six characters matches as a whole word only. No list file: this check is skipped
#     (pre-commit refuses on that case itself). No override.
#   The python3 is /usr/bin/python3 when present, else the first on PATH (a broken shim earlier
#   on PATH cannot refuse honest work; GUARD_PYTHON_PREFERRED is a test seam).
# Zero-width characters (U+200B/C/D, U+2060, U+FEFF) are stripped before any of this, so
# `Cla<zero-width>ude` is read as `Claude`. Comment lines (`#`) are dropped, as git drops
# them itself.
# Tests: hooks/test-hooks.sh (sections 5 and 29; `refresh 2026-09-29 (b)`).
msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Zero-width characters, written as their UTF-8 bytes so this works with any locale.
ZWSP=$(printf '\342\200\213'); ZWNJ=$(printf '\342\200\214'); ZWJ=$(printf '\342\200\215')
WJ=$(printf '\342\201\240');   BOM=$(printf '\357\273\277')
msg="$(LC_ALL=C sed -e "s/$ZWSP//g" -e "s/$ZWNJ//g" -e "s/$ZWJ//g" -e "s/$WJ//g" -e "s/$BOM//g" -e '/^#/d' "$msg_file")"

refuse() {
  echo "commit-msg hook: REFUSED — $1" >&2
  [ -n "${2:-}" ] && printf 'Offending line(s):\n%s\n' "$2" >&2
  exit 1
}

# (a) the generated-with signature, and an Anthropic no-reply address, anywhere.
hit="$(printf '%s\n' "$msg" | grep -niE 'noreply@anthropic\.com|Generated with \[?Claude Code')"
[ -n "$hit" ] && refuse "the message carries Claude/Anthropic attribution." "$hit"

# (a2) a redaction-list name typed into the message itself.
names_file="$HOME/.claude/.redaction-names.local"
if [ -r "$names_file" ]; then
  # The preferred interpreter must RUN, as in hooks/guard-lib.sh guard_resolve_python — a Mac's
  # /usr/bin/python3 stub must not refuse every message. Tests: `review fixes (critical)` 1 (commit-msg).
  PY="${GUARD_PYTHON_PREFERRED:-/usr/bin/python3}"
  if ! { [ -x "$PY" ] && "$PY" -c '' >/dev/null 2>&1; }; then PY="$(command -v python3 2>/dev/null)"; fi
  nhit="$(printf '%s\n' "$msg" | "$PY" -c '
import re, sys
text = sys.stdin.read().lower()
n = 0
for ln in open(sys.argv[1], encoding="utf-8"):
    s = ln.strip()
    if not s or s.startswith("#"): continue
    word = False
    if s.lower().startswith("word:"): s = s[5:].strip(); word = True
    if not s: continue
    if len(s) < 6: word = True
    nd = s.lower()
    if word: n += len(re.findall(r"(?<![A-Za-z0-9])" + re.escape(nd) + r"(?![A-Za-z0-9])", text))
    elif nd in text: n += 1
print(n)
' "$names_file" 2>/dev/null)" || refuse "the redaction-list check could not run (no working python3), so the message is not judged. Install python3 or fix PATH."
  [ "${nhit:-0}" != "0" ] && refuse "the commit MESSAGE holds a name from the redaction list (${nhit} match(es)); remove it and commit again. There is no override."
fi

# (b) the trailer block: the LAST paragraph, when it is not also the first one and every
#     one of its lines is `Key: value`. Anything else is prose and is left alone.
trailers="$(printf '%s\n' "$msg" | awk '
  { lines[NR] = $0 }
  END {
    n = NR
    while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
    if (n == 0) exit
    s = n
    while (s > 1 && lines[s-1] !~ /^[[:space:]]*$/) s--
    if (s == 1) exit                       # one paragraph only: subject/body, no trailers
    for (i = s; i <= n; i++) if (lines[i] !~ /^[A-Za-z][A-Za-z0-9-]*:[ \t]/) exit
    for (i = s; i <= n; i++) print lines[i]
  }')"
if [ -n "$trailers" ]; then
  thit="$(printf '%s\n' "$trailers" | grep -niE 'claude|anthropic')"
  [ -n "$thit" ] && refuse "a commit-message trailer names Claude/Anthropic." "$thit"
fi

# (c) the committer identity, which lands in the commit object beside the author.
cident="$(git var GIT_COMMITTER_IDENT 2>/dev/null)"
if [ -n "$cident" ] && printf '%s' "$cident" | grep -qiE 'claude|anthropic'; then
  refuse "the COMMITTER identity names Claude/Anthropic (${cident%% <*}). Set GIT_COMMITTER_NAME/GIT_COMMITTER_EMAIL, or git config user.name/user.email, to your own."
fi
exit 0

#!/bin/bash
# Fires on every `git commit`, whatever made it (an agent, a script, or a person at the
# terminal). Checks, most independently opt-in through their own config file — no config
# means that check is inert, the safe default for a fresh install:
#   (1) identity — BOTH the author and the committer, enforced only if hooks/backup.conf
#       sets AUTHOR=...; otherwise this repo hasn't opted in and the check is skipped
#       silently. The committer matters as much as the author: `GIT_COMMITTER_NAME=…
#       git commit` writes that name into the commit object even when the author line is
#       yours. A repo can also opt OUT explicitly (a work repo with its own author, on a
#       machine that also runs a personal backup.conf): `git config --local hooks.identity
#       false` skips this check silently, same as having no AUTHOR at all.
#       WHAT THIS CHECK CANNOT SEE, stated plainly: a commit this hook never runs on. A
#       `git rebase` replays commits without firing pre-commit or commit-msg on any of
#       them, so `GIT_COMMITTER_NAME=… git rebase` writes whatever identity it likes; and
#       `git commit --author="…"` sets an author the flag never puts into
#       `git var GIT_AUTHOR_IDENT`, which is what is read here. Both are caught later, by
#       git-hooks/pre-push, which re-checks the author AND committer of every commit a
#       push would add. A `--amend` IS caught here, because it runs this hook.
#   (2) a channel-file insertion ceiling — a shared file several people or sessions
#       append to (running notes, a decision log, a changelog) should gain only a bounded
#       number of lines per commit; a much bigger jump usually means two sessions' entries
#       landed in the same commit. Configured in hooks/channel-ceiling.conf (see
#       hooks/channel-ceiling.conf.example) as a LIMIT plus a list of repo-relative glob
#       patterns — the SAME file hooks/channel-size-guard.sh reads for its own, separate
#       live-growth check, so a line there may carry extra columns this check ignores; only
#       the first field (the pattern) matters here. No file means this check never runs.
#       ADDED and modified files both count (deleting a channel file and re-adding it in
#       the next commit was otherwise a free way past the ceiling); archives (any path
#       containing "ARCHIVE") stay exempt. Override for a deliberate large write, one
#       commit: `SWEEP=1 git commit ...` (this check only) — every use is logged by
#       hooks/override-ledger.sh, if present.
#   (3) a root rules file (`CLAUDE.md`, path exactly at the repo top level, never
#       `*/CLAUDE.md` in a subfolder) is capped by word count on the STAGED blob: 4000
#       words if the repo's top level is `$HOME/.claude` (your global rulebook), 5750
#       otherwise (a project rulebook). A rulebook that grows without limit stops being
#       read. A RENAME counts as an add (`git mv sub/CLAUDE.md CLAUDE.md` is how a big
#       file walked in before). Override, one commit: `RULES_CAP_OK=1 git commit ...`.
#   (4) privacy — runs in EVERY repository, unconditionally, on the ADDED lines of the
#       staged diff (an old line already in history isn't re-introduced by touching the
#       file again), on the staged PATHS themselves, and on the raw bytes of any staged
#       blob git calls binary (a UTF-16 document has a NUL in every other byte, so it has
#       no "+" lines at all). What it looks for:
#         - an absolute home path (`/Users/<name>/` or `/home/<name>/`, macOS and Linux)
#           or its encoded form (`-Users-<name>`, `-home-<name>`: a Claude Code project-folder
#           name) whose <name> isn't a known placeholder (node, runner, user, app, USERNAME,
#           username, you, yourname, example — Docker base images, CI runners and doc
#           placeholders all use these);
#         - any name listed in $HOME/.claude/.redaction-names.local (one per line, #
#           comments allowed). This file must EXIST for the commit to proceed at all —
#           no file there means privacy hasn't been set up on this machine, so the commit
#           is REFUSED (fail closed) rather than silently skipping the names check. An
#           existing file, even an empty one, is enough — it just means no names are
#           configured yet, so only the home-path and email checks apply. An entry under
#           six characters, or one written `word:Name`, matches only as a WHOLE word, so a
#           short handle doesn't refuse every longer word that contains it;
#         - an email address whose domain is not on a small built-in allowlist (GitHub's
#           and Apple's own no-reply domains, plus the RFC 2606 example.* domains) or in
#           hooks/allowed-email-domains.conf (see
#           hooks/allowed-email-domains.conf.example, one domain per line, added to the
#           built-in list) — catches a real personal address before it reaches a public
#           commit. An scp-style git remote (`git@<host>:user/repo.git`) is a URL, not
#           an address, and is skipped. This half has a safe built-in default and does not
#           fail closed.
#       Zero-width characters (U+200B/C/D, U+2060, U+FEFF) and the soft hyphen / invisible separator
#       (U+00AD, U+2063) are stripped before matching. The diff is always read with `--no-ext-diff
#       --no-textconv`, so a `diff.external` setting or a diff/textconv driver cannot blind the scans.
#       A home path ends its name at a separator, a quote, whitespace, `:`, `,`, `;`, a closing bracket
#       or the end of the line; the Users or home folder spelled in any letter case, `C:\Users\<name>` and the
#       JSON-escaped `\/Users\/<name>` count (the any-case form only after a non-word character, and
#       never with an all-digit name: an all-digit REST route is not a folder; a web URL ending in a home segment with nothing
#       after the name passes). The system folders `Shared`, `Public` and `Default` are excluded like the
#       placeholders (compared in any letter case). `-home-<name>` (the encoded
#       Linux form) counts only with a name and then `-` or `/` after it, so CSS (`--home-banner`) and
#       flags (`--home-dir`) pass; the cost is that a bare `-home-<name>` with nothing after it is not seen.
#       A staged PATH is read for the encoded form and for `Users/<name>/` at its start or after a `/`
#       (never `home/`: `docs/home/...` is honest).
#       NOT enforced (stated plainly): a URL-encoded path (`%2FUsers%2F<name>`), a `~<name>/` spelling,
#       a non-ASCII account name (`/home/józef/`), and the cases above that only a human can tell apart.
#       A git worktree of a listed BARE repo counts as that repo (the listed path is the bare folder).
#       Limits, stated plainly: a name SPLIT ACROSS TWO LINES is not caught (the scan is
#       line by line), and neither is one that is base64- or otherwise encoded — the
#       `npm run test:privacy`-style full sweep before anything goes public remains the
#       authority. Deliberate override, one commit: `PRIVACY_OK=1 git commit ...` (skips
#       all of (4)).
#
#   (4b) key-shaped secrets — the ADDED lines, staged paths and binary blobs are scanned
#       with the ONE SECRET_RE in hooks/auto-backup.sh (read from that file at run time, so
#       the backup hook and this one can never drift; if the file is missing the commit is
#       REFUSED). A placeholder value (your-, example, xxxx, <…>, a URL password like user:password@; the list is PLACEHOLDER_RE in the same file) and a line carrying
#       `# pragma: allow-secret` pass. PRIVACY_OK does NOT lift this: a real key belongs in
#       .env, never in history. Runs on merge commits too.
#   (3b) staged size — the staged files' total is capped (default 10 MB; hooks/commit-size.conf
#       sets `LIMIT_MB=<n>`, see hooks/commit-size.conf.example). Deliberate one commit:
#       `SIZE_OK=1 git commit ...` — writes one line in hooks/override-ledger.sh's ledger and
#       is REFUSED if that line cannot be written.
#   Privacy exceptions: a repo whose toplevel is listed (one absolute path per line, # comments)
#       in ~/.claude/.privacy-name-exceptions.local skips the NAMES limb only (a repo that
#       legitimately documents the guard's own names; a git worktree of a listed repo counts
#       as that repo); home-path, email and key checks still bind there. A repo whose toplevel is ~/.claude itself skips the EMAIL limb only
#       (vendored skill text carries example addresses).
#   The python3 run here is /usr/bin/python3 when present, else the first on PATH, so a broken
#       shim earlier on PATH cannot refuse honest work (GUARD_PYTHON_PREFERRED is a test seam).
#
# git-hooks/pre-merge-commit runs check (4) alone on a merge commit, which no pre-commit
# hook ever sees; it calls this script back with PRE_COMMIT_PRIVACY_ONLY=1.
# Tests: hooks/test-hooks.sh (sections 6, 6b, 12, 13, 13b, 19, 24, 29; `refresh 2026-09-29 (b)`).

# Same run-probe as the other guards (hooks/guard-lib.sh guard_resolve_python): the preferred
# interpreter must RUN (`-c ''`), else the PATH python3 — a Mac's /usr/bin/python3 stub that exits
# non-zero must not refuse every commit. Sourced when installed next to this hook's folder; the
# inline copy below is only for a kit whose guard-lib.sh is missing. Tests: `review fixes (critical)` 1.
GUARD_LIB_PC="$(dirname "$0")/../hooks/guard-lib.sh"
if [ -r "$GUARD_LIB_PC" ]; then . "$GUARD_LIB_PC"; PY="$GUARD_PY"
else
  PY="${GUARD_PYTHON_PREFERRED:-/usr/bin/python3}"
  if ! { [ -x "$PY" ] && "$PY" -I -c '' >/dev/null 2>&1; }; then PY="$(command -v python3 2>/dev/null)"; fi
fi
if [ -z "$PY" ]; then echo "pre-commit hook: REFUSED — no python3 found, so the privacy check cannot run." >&2; exit 1; fi

if [ "${PRE_COMMIT_PRIVACY_ONLY:-0}" = "1" ]; then
  HOOK_LABEL="${HOOK_LABEL:-pre-commit hook}"
else
HOOK_LABEL="pre-commit hook"

# ---- (1) identity: the author AND the committer ----
if [ "$(git config --local --get hooks.identity 2>/dev/null)" = "false" ]; then
  : # this repo opted out — skip silently
else
  CONF="$HOME/.claude/hooks/backup.conf"
  AUTHOR=""
  if [ -f "$CONF" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|'#'*) continue ;; esac
      case "$line" in AUTHOR=*) AUTHOR="${line#AUTHOR=}" ;; esac
    done < "$CONF"
  fi
  if [ -n "$AUTHOR" ]; then
    for who in AUTHOR COMMITTER; do
      ident="$(git var "GIT_${who}_IDENT" 2>/dev/null)"
      [ -n "$ident" ] || continue      # no readable identity for this role: nothing to judge
      case "$ident" in
        "$AUTHOR"*) ;;
        *)
          lower="$(printf '%s' "$who" | tr '[:upper:]' '[:lower:]')"
          echo "pre-commit hook: REFUSED — the $lower identity does not match hooks/backup.conf." >&2
          echo "  want: $AUTHOR" >&2
          echo "  got:  ${ident%% >*} >" >&2
          echo "  Per-repo opt-out: git config --local hooks.identity false" >&2
          exit 1 ;;
      esac
    done
  fi
fi

# ---- (2) optional: channel-file insertion ceiling ----
CEILING_CONF="$HOME/.claude/hooks/channel-ceiling.conf"
if [ -s "$CEILING_CONF" ]; then
  if [ "${SWEEP:-0}" = "1" ]; then
    L="$HOME/.claude/hooks/override-ledger.sh"
    [ -f "$L" ] && bash "$L" SWEEP "git commit (pre-commit: the channel ceiling lifted)"
  else
    LIMIT=100
    patterns=()
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|'#'*) continue ;; esac
      case "$line" in LIMIT=*) LIMIT="${line#LIMIT=}"; continue ;; esac
      set -- $line   # only the first field is the pattern; channel-size-guard.sh's
      patterns+=("$1")   # optional unit/band/stop columns are ignored here.
    done < "$CEILING_CONF"
    cfail=0
    while IFS=$'\t' read -r added _deleted path; do
      [ -z "$path" ] && continue
      case "$path" in *ARCHIVE*) continue ;; esac
      match=0
      for pat in "${patterns[@]}"; do
        case "$path" in $pat) match=1; break ;; esac
      done
      [ "$match" = 1 ] || continue
      if [ "$added" != "-" ] && [ "$added" -gt "$LIMIT" ]; then
        echo "pre-commit hook: REFUSED — $path gains $added lines in this commit (ceiling $LIMIT, hooks/channel-ceiling.conf)." >&2
        echo "  A large jump usually means another session's text landed in the same commit as yours." >&2
        echo "  Reconcile: git diff --cached -- $path   |   deliberate large write: SWEEP=1 git commit ..." >&2
        cfail=1
      fi
    done < <(git diff --cached --numstat --diff-filter=AM)
    [ "$cfail" = 1 ] && exit 1
  fi
fi

# ---- (3) root CLAUDE.md word cap ----
# Path exactly "CLAUDE.md" at a repo's top level, never a subfolder's "*/CLAUDE.md". The
# global rulebook ($HOME/.claude, e.g. a config-backup repo whose toplevel IS $HOME/.claude)
# gets the tighter cap; a project rulebook gets the looser one. A rename or copy INTO the
# root is an add as far as this cap is concerned. RULES_CAP_OK=1 skips this check only.
if [ "${RULES_CAP_OK:-0}" = "1" ]; then
  if git diff --cached --name-only --diff-filter=AMRC | grep -qx 'CLAUDE.md'; then
    L="$HOME/.claude/hooks/override-ledger.sh"
    [ -f "$L" ] && bash "$L" RULES_CAP_OK "git commit (pre-commit: the rules-file cap lifted)"
  fi
else
  while IFS= read -r path; do
    [ "$path" = "CLAUDE.md" ] || continue
    toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"
    if [ "$toplevel" = "$HOME/.claude" ]; then cap=4000; else cap=5750; fi
    words="$(git show ":$path" | wc -w | tr -d ' ')"
    if [ "$words" -gt "$cap" ]; then
      echo "pre-commit hook: REFUSED — $path is $words words; the rules file is capped at $cap. Trim it, or, deliberately: RULES_CAP_OK=1 git commit ..." >&2
      exit 1
    fi
  done < <(git diff --cached --name-only --diff-filter=AMRC)
fi
# ---- (3b) staged size ceiling ----
LIMIT_MB=10
SIZE_CONF="$HOME/.claude/hooks/commit-size.conf"
if [ -f "$SIZE_CONF" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in LIMIT_MB=*) LIMIT_MB="${line#LIMIT_MB=}" ;; esac
  done < "$SIZE_CONF"
fi
case "$LIMIT_MB" in ''|*[!0-9]*|0) LIMIT_MB=10 ;; esac
total=0
while IFS= read -r -d '' path; do
  sz="$(git cat-file -s ":$path" 2>/dev/null)"
  total=$((total + ${sz:-0}))
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ "$total" -gt $((LIMIT_MB * 1048576)) ]; then
  if [ "${SIZE_OK:-0}" != "1" ]; then
    echo "pre-commit hook: REFUSED — staged files total $((total / 1048576)) MB, over the ${LIMIT_MB} MB ceiling (hooks/commit-size.conf). Deliberate: SIZE_OK=1 git commit ..." >&2
    exit 1
  fi
  L="$HOME/.claude/hooks/override-ledger.sh"
  if ! { [ -f "$L" ] && bash "$L" SIZE_OK "git commit (pre-commit: the ${LIMIT_MB} MB ceiling lifted)" "$total bytes staged"; }; then
    echo "pre-commit hook: REFUSED — the SIZE_OK override could not be recorded in the override ledger (hooks/override-ledger.sh is missing, or its ledger file cannot be written), so it is NOT honoured. Fix the ledger path, then commit again." >&2
    exit 1
  fi
fi
fi   # end of the checks pre-merge-commit skips

# ---- (4b) key-shaped secrets: ADDED lines, staged paths, binary blobs; PRIVACY_OK does not lift it ----
# One list: SECRET_RE is read from hooks/auto-backup.sh (next to git-hooks/ in the kit and in an
# install), so the backup hook's scan and this one cannot drift. Missing file = REFUSED.
_here="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"
SECRET_RE_SRC=""; PLACEHOLDER_RE_SRC=""
for _ab in "$_here/../hooks/auto-backup.sh" "$HOME/.claude/hooks/auto-backup.sh"; do
  if [ -f "$_ab" ]; then
    SECRET_RE_SRC="$(sed -n "s/^SECRET_RE='\(.*\)'\$/\1/p" "$_ab" | head -1)"
    PLACEHOLDER_RE_SRC="$(sed -n "s/^PLACEHOLDER_RE='\(.*\)'\$/\1/p" "$_ab" | head -1)"
    [ -n "$SECRET_RE_SRC" ] && break
  fi
done
[ -n "$PLACEHOLDER_RE_SRC" ] || PLACEHOLDER_RE_SRC='your-|example|xxxx|<|>'   # an older auto-backup.sh without the shared list
if [ -z "$SECRET_RE_SRC" ]; then
  echo "${HOOK_LABEL:-pre-commit hook}: REFUSED — cannot read SECRET_RE from hooks/auto-backup.sh (missing or changed), so the key scan cannot run. Restore that file." >&2
  exit 1
fi
HOOK_LABEL="${HOOK_LABEL:-pre-commit hook}" SECRET_RE_SRC="$SECRET_RE_SRC" PLACEHOLDER_RE_SRC="$PLACEHOLDER_RE_SRC" "$PY" -I - <<'PY' || exit 1
import os, re, subprocess, sys
LABEL = os.environ.get("HOOK_LABEL") or "pre-commit hook"
SECRET_RE = re.compile(os.environ["SECRET_RE_SRC"])
PLACEHOLDER_RE = re.compile(os.environ["PLACEHOLDER_RE_SRC"], re.I)
def placeholder(m):
    return PLACEHOLDER_RE.search(m) is not None
def hits(text):
    return sum(1 for m in SECRET_RE.finditer(text) if not placeholder(m.group(0)))
def git_bytes(args):
    return subprocess.run(["git"] + args, capture_output=True).stdout
bad = {}
text = git_bytes(["diff", "--cached", "--no-ext-diff", "--no-textconv", "-U0", "--no-color"]).decode("utf-8", "surrogateescape")
cur = None
in_hdr = False     # the "+++ " file header only counts between a "diff --git" line and the first "@@"
for line in text.splitlines():
    if line.startswith("diff --git "):
        in_hdr = True; continue
    if line.startswith("@@"):
        in_hdr = False; continue
    if in_hdr:
        if line.startswith("+++ "):
            p = line[4:]; cur = None if p == "/dev/null" else (p[2:] if p.startswith(("a/", "b/")) else p)
        continue
    if not line.startswith("+") or "pragma: allow-secret" in line:
        continue
    n = hits(line[1:])
    if n and cur: bad[cur] = bad.get(cur, 0) + n
for p in [q for q in git_bytes(["diff", "--cached", "--no-ext-diff", "--no-textconv", "--name-only", "-z", "--diff-filter=ACMR"]).decode("utf-8", "surrogateescape").split("\0") if q]:
    n = hits(p)
    if n: bad[p] = bad.get(p, 0) + n
raw = git_bytes(["diff", "--cached", "--no-ext-diff", "--no-textconv", "--numstat", "-z", "--diff-filter=ACMR"]).decode("utf-8", "surrogateescape").split("\0")
i = 0
while i < len(raw):
    rec = raw[i]; i += 1
    parts = rec.split("\t")
    if len(parts) < 3: continue
    path = parts[2]
    if not path:
        path = raw[i + 1] if i + 1 < len(raw) else ""; i += 2
    if parts[0] == "-" and parts[1] == "-" and path:
        blob = git_bytes(["show", ":" + path])[:2_000_000]
        n = hits(blob.decode("utf-8", "ignore")) + hits(blob.decode("utf-16", "ignore"))
        if n: bad[path] = bad.get(path, 0) + n
if bad:
    print(f"{LABEL}: REFUSED — a key-shaped token is in the ADDED lines, a staged file NAME or a staged binary blob "
          "(file -> match count, never the matched text): " + ", ".join(f"{k} -> {v}" for k, v in bad.items()), file=sys.stderr)
    print("  Remove it, re-stage, commit again. PRIVACY_OK does not lift this: a real key belongs in .env, gitignored. "
          "A placeholder (your-key-here, example, xxxx, <key>) or a line with '# pragma: allow-secret' passes.", file=sys.stderr)
    sys.exit(1)
PY

# ---- (4) privacy: the ADDED lines, the staged PATHS, and any staged binary blob ----
# PRIVACY_OK=1 lifts this check for ONE commit like every other override: the check still runs, and
# only when it WOULD have refused is the bypass written to hooks/override-ledger.sh — and REFUSED if
# that line cannot be written. The ledger line names no file or name (a listed name can be a path).
if [ "${PRIVACY_OK:-}" = "1" ]; then PRIV_ERR="$(mktemp)"; exec 3>"$PRIV_ERR"; else PRIV_ERR=""; exec 3>&2; fi
HOOK_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" HOOK_LABEL="$HOOK_LABEL" "$PY" -I - <<'PY' 2>&3

import re, subprocess, sys, os

LABEL = os.environ.get("HOOK_LABEL") or "pre-commit hook"
ZW = dict.fromkeys(map(ord, "\u200b\u200c\u200d\u2060\ufeff\u00ad\u2063"), None)
def dezw(s):
    return s.translate(ZW)

names_file = os.path.expanduser("~/.claude/.redaction-names.local")
if not os.path.isfile(names_file):
    print(f"{LABEL}: REFUSED — {names_file} does not exist, so the privacy check's "
          "names list is not configured on this machine (fail closed, not open). Create the "
          "file (an empty one is enough to proceed with no names configured), one real name "
          "or handle to guard per line. Deliberate override, one commit: PRIVACY_OK=1 git commit ...",
          file=sys.stderr)
    sys.exit(1)
# Each entry is (lowercased needle, whole-word-only). A short entry matches only as a whole
# word — otherwise a three-letter handle refuses every longer word containing it. `word:X`
# asks for the same treatment explicitly, whatever the length.
needles = []
for ln in open(names_file, encoding="utf-8"):
    s = dezw(ln).strip()
    if not s or s.startswith("#"):
        continue
    if re.fullmatch(r"\[[^\]]*\]", s):     # a [guard] / [redact-only] section header is not a name
        continue
    word_only = False
    if s.lower().startswith("word:"):
        s = s[5:].strip()
        word_only = True
    if not s:
        continue
    if len(s) < 6:
        word_only = True
    needles.append((s.lower(), word_only))

# A76: a repo whose toplevel is listed (one absolute path per line, # comments) in
# ~/.claude/.privacy-name-exceptions.local skips the NAMES limb only; home-path, email and key
# checks still bind. A73: a repo whose toplevel IS ~/.claude skips the EMAIL limb only.
_root = os.environ.get("HOOK_ROOT", "")
skip_email = False
if _root:
    _root = os.path.realpath(_root)
    skip_email = _root == os.path.realpath(os.path.expanduser("~/.claude"))
    try:
        with open(os.path.expanduser("~/.claude/.privacy-name-exceptions.local"), encoding="utf-8") as fh:
            _listed = {os.path.realpath(x.strip()) for x in fh if x.strip() and not x.strip().startswith("#")}
            # A git worktree of a listed repo counts as that repo: its shared .git folder sits
            # inside the listed top-level folder (--git-common-dir, absolute, is <listed>/.git).
            _main = None
            try:
                _common = subprocess.run(["git", "-C", _root, "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                         capture_output=True, text=True, timeout=10).stdout.strip()
                # a worktree of a normal repo: the common dir is <listed>/.git; of a BARE repo: the
                # bare folder itself is what is listed
                _main = os.path.realpath(os.path.dirname(_common) if os.path.basename(_common) == ".git" else _common)
            except Exception:
                _main = None
            if _root in _listed or (_main and _main in _listed):
                needles = []
    except OSError:
        pass

EXCLUDED = {"node", "runner", "user", "app", "username", "you", "yourname", "example", "shared", "public", "default"}   # compared lower-cased; the last three are system folders
# A home path: Users or home, a separator, a name, and the name must END there: at a separator, a quote,
# whitespace, a colon, a comma, a semicolon, a closing bracket, or the end of the line (so `export HOME=<path>`
# counts as much as a path with more after the name). A separator is `/`, `\`, a JSON-escaped `\/` or `\\`, so a Windows path
# (C:\Users\x) and a JSON-escaped one count too. `Users`/`home` in any other letter case counts only when the
# separator does not follow a word character (a REST route such as an API users endpoint is honest) and the name is not all digits.
_SEP = r"(?:\\\\|\\/|[/\\])"
_END = r"(?=[/\\\"'\s:,;)\]}>`]|$)"
home_path = re.compile(_SEP + r"(?:Users|home)" + _SEP + r"([A-Za-z0-9_.-]+)" + _END)
home_path_ci = re.compile(r"(?<![A-Za-z0-9_.-])" + _SEP + r"(?:Users|home)" + _SEP + r"([A-Za-z0-9_.-]+)" + _END, re.I)
# The encoded form too: Claude Code names a project folder after its path (a dash, Users or home,
# a dash, the account name). No letter, digit or dash may stand before the first dash, so a word that
# only ENDS in it and a flag such as --home-dir pass, and a placeholder such as <account> passes.
# `-home-` (a word CSS and flags use) counts only with a path-like neighbour: a name and then `-` or `/`.
# Counted and excluded exactly like the slashed form. Staged file NAMES are read for the encoded form and
# for a slashed `Users/<name>/` (a folder copied out of the project store, a backed-up home folder).
home_enc = re.compile(r"(?<![A-Za-z0-9-])-(?:Users-([A-Za-z0-9_.]+)|home-([A-Za-z0-9_.]+)(?=[-/]))")
path_users = re.compile(r"(?:^|/)Users/([A-Za-z0-9_.-]+)/")

def _ok(n):
    return n.lower() in EXCLUDED or not re.search(r"[A-Za-z0-9]", n)    # a run of dots/dashes is no name

def _url_bare(d, m):
    # `https://host/home/faq` (a web path with nothing after the name) is a URL, not a folder: keep the
    # old rule there (a separator must follow the name)
    return re.search(r"://[^\s/]*$", d[:m.start()]) is not None and d[m.end(1):m.end(1) + 1] not in ("/", "\\")

def name_hits(text):
    low = dezw(text).lower()
    n = 0
    for nd, word_only in needles:
        if word_only:
            n += len(re.findall(r"(?<![A-Za-z0-9])" + re.escape(nd) + r"(?![A-Za-z0-9])", low))
        elif nd in low:
            n += 1
    return n

def home_hits(text):
    d = dezw(text)
    spans = set()
    for m in home_path.finditer(d):
        if not _ok(m.group(1)) and not _url_bare(d, m): spans.add(m.start(1))
    for m in home_path_ci.finditer(d):
        if not _ok(m.group(1)) and not m.group(1).isdigit() and not _url_bare(d, m): spans.add(m.start(1))
    return len(spans) + enc_hits(d)

def enc_hits(text):
    return sum(1 for m in home_enc.finditer(dezw(text)) if not _ok(m.group(1) or m.group(2)))

def path_hits(p):
    d = dezw(p)
    return enc_hits(d) + sum(1 for m in path_users.finditer(d) if not _ok(m.group(1)))

# Email domains: a small, universal built-in default plus anything the user adds in
# hooks/allowed-email-domains.conf (one domain per line, # comments allowed). No conf file
# just means the built-in default is all that's allowed — never fails closed, since the
# default already covers the common placeholder/service cases.
ALLOWED_EMAIL_DOMAINS = {
    "users.noreply.github.com", "privaterelay.appleid.com",
    "example.com", "example.net", "example.org", "example.test", "localhost",
}
domains_conf = os.path.expanduser("~/.claude/hooks/allowed-email-domains.conf")
if os.path.isfile(domains_conf):
    for ln in open(domains_conf, encoding="utf-8"):
        s = ln.strip()
        if s and not s.startswith("#"):
            ALLOWED_EMAIL_DOMAINS.add(s.lower())
EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@([A-Za-z0-9.-]+\.[A-Za-z]{2,})")
# `git@<host>:user/repo.git` — an scp-style remote, not an address. The colon and the
# slashed path after it are what tell the two apart; "write to someone at example dot com: details" has no
# slash before the next space and is still judged as an address.
SCP_RE = re.compile(r"[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}:[A-Za-z0-9._~-]+/[A-Za-z0-9._~/-]*")

def git_bytes(args):
    return subprocess.run(["git"] + args, capture_output=True).stdout

offenders = {}
email_offenders = {}
def add_offender(path, n):
    if n and path:
        offenders[path] = offenders.get(path, 0) + n

# --- (a) the ADDED lines of the text diff ---
text = git_bytes(["diff", "--cached", "--no-ext-diff", "--no-textconv", "-U0", "--no-color"]).decode("utf-8", "surrogateescape")
cur_file = None
in_hdr = False     # the "+++ " file header only counts between a "diff --git" line and the first "@@"
for line in text.splitlines():
    if line.startswith("diff --git "):
        in_hdr = True; continue
    if line.startswith("@@"):
        in_hdr = False; continue
    if in_hdr:
        if line.startswith("+++ "):
            p = line[4:]
            cur_file = p[2:] if p.startswith(("a/", "b/")) else p
            if cur_file == "/dev/null":
                cur_file = None
        continue
    if not line.startswith("+"):
        continue
    added = line[1:]
    add_offender(cur_file, name_hits(added) + home_hits(added))
    if cur_file and not skip_email:
        scp_spans = [m.span() for m in SCP_RE.finditer(added)]
        for m in EMAIL_RE.finditer(added):
            if any(s <= m.start() and m.end() <= e for s, e in scp_spans):
                continue
            domain = m.group(1).lower()
            if domain not in ALLOWED_EMAIL_DOMAINS:
                cnt, _ex = email_offenders.get(cur_file, (0, None))
                local = m.group(0).split("@")[0]
                email_offenders[cur_file] = (cnt + 1, f"{(local[:1] or 'x')}***@{domain}")

# --- (b) the staged PATHS themselves: a name used as a filename has no "+" line at all ---
staged = [p for p in git_bytes(["diff", "--cached", "--no-ext-diff", "--no-textconv", "--name-only", "-z", "--diff-filter=ACMR"])
          .decode("utf-8", "surrogateescape").split("\0") if p]
for p in staged:
    # names, the encoded form and a slashed Users/<name>/: a staged path is always repo-relative, so it
    # can never BE an absolute home path, and a repo with a folder called home inside docs must not be
    # refused for it (only the capitalised Users/ counts, never home/).
    n = name_hits(p) + path_hits(p)
    if n:
        offenders[p] = offenders.get(p, 0) + n

# --- (c) staged blobs git calls binary: no "+" lines, so decode the bytes and look ---
raw = git_bytes(["diff", "--cached", "--no-ext-diff", "--no-textconv", "--numstat", "-z", "--diff-filter=ACMR"]).decode("utf-8", "surrogateescape")
fields = raw.split("\0")
i = 0
binary_paths = []
while i < len(fields):
    rec = fields[i]; i += 1
    if not rec.strip():
        continue
    parts = rec.split("\t")
    if len(parts) < 3:
        continue
    add, dele, inline = parts[0], parts[1], parts[2]
    if inline:
        path = inline
    else:                       # a rename/copy record: old path, then new path
        path = fields[i + 1] if i + 1 < len(fields) else (fields[i] if i < len(fields) else "")
        i += 2
    if add == "-" and dele == "-" and path:
        binary_paths.append(path)
for p in binary_paths:
    blob = git_bytes(["show", ":" + p])[:2_000_000]
    n = 0
    for enc in ("utf-8", "utf-16-le", "utf-16-be", "latin-1"):
        try:
            t = blob.decode(enc, "ignore")
        except Exception:
            continue
        n += name_hits(t) + home_hits(t)
    if n:
        offenders[p] = offenders.get(p, 0) + n

if offenders:
    print(f"{LABEL}: REFUSED — an absolute home path or a listed name is in an ADDED "
          "line, a staged file NAME, or a staged binary blob (file -> matches): " +
          ", ".join(f"{k} -> {v}" for k, v in offenders.items()), file=sys.stderr)
    print("  Remove it, re-stage, commit again. Deliberate override, one commit: PRIVACY_OK=1 git commit ...", file=sys.stderr)
    sys.exit(1)
if email_offenders:
    print(f"{LABEL}: REFUSED — an email address outside the allowed domains is in an "
          "ADDED line of the staged diff (file -> count, one masked example): " +
          ", ".join(f"{k} -> {v[0]} ({v[1]})" for k, v in email_offenders.items()), file=sys.stderr)
    print("  If the domain is legitimate, add it to hooks/allowed-email-domains.conf. "
          "Deliberate override, one commit: PRIVACY_OK=1 git commit ...", file=sys.stderr)
    sys.exit(1)
PY
priv_rc=$?
exec 3>&-
if [ -n "$PRIV_ERR" ]; then
  rm -f "$PRIV_ERR"
  if [ "$priv_rc" != 0 ]; then
    L="$HOME/.claude/hooks/override-ledger.sh"
    if ! { [ -f "$L" ] && bash "$L" PRIVACY_OK "git commit (pre-commit: the privacy check lifted)" "a listed name, a home path or an email address was in the staged commit"; }; then
      echo "$HOOK_LABEL: REFUSED — the PRIVACY_OK override could not be recorded in the override ledger (hooks/override-ledger.sh is missing, or its ledger file cannot be written), so it is NOT honoured. Fix the ledger path, then commit again." >&2
      exit 1
    fi
  fi
  exit 0
fi
[ "$priv_rc" = 0 ] || exit 1
exit 0

#!/bin/bash
# Fires on every `git commit`, whatever made it (an agent, a script, or a person at the
# terminal). Two independent checks:
#   (1) author identity — enforced only if hooks/backup.conf sets AUTHOR=...; otherwise
#       this repo hasn't opted in and the check is skipped silently.
#   (2) privacy — refuses a commit whose STAGED content holds an absolute home path
#       (macOS's `Users` folder or Linux's `/home/`, each followed by an account name) or
#       a line from an optional personal list, ~/.claude/redaction-names.local (one name
#       per line; no list just means only the path check runs).
# (The private version this came from has a third check, a cap on how many lines a shared
# "running notes" file may gain in one commit — that belongs in a project's own hooks.)

# ---- (1) author identity ----
CONF="$HOME/.claude/hooks/backup.conf"
AUTHOR=""
if [ -f "$CONF" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in AUTHOR=*) AUTHOR="${line#AUTHOR=}" ;; esac
  done < "$CONF"
fi
if [ -n "$AUTHOR" ]; then
  ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null)"
  case "$ident" in
    "$AUTHOR"*) ;;
    *)
      echo "pre-commit hook: REFUSED — author identity does not match hooks/backup.conf." >&2
      echo "  want: $AUTHOR" >&2
      echo "  got:  ${ident%% >*} >" >&2
      exit 1 ;;
  esac
fi

# ---- (2) privacy: staged content vs an absolute home path or a listed name ----
python3 - <<'PY' || exit 1
import re, subprocess, sys, os
names_file = os.path.expanduser("~/.claude/redaction-names.local")
needles = []
if os.path.isfile(names_file):
    for ln in open(names_file, encoding="utf-8"):
        s = ln.strip()
        if s and not s.startswith("#"):
            needles.append(s.lower())
home_path = re.compile(rb"/(Users|home)/[A-Za-z0-9_]")
staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
                         capture_output=True).stdout
offenders = {}
for rel in [p for p in staged.decode("utf-8", "surrogateescape").split("\0") if p]:
    blob = subprocess.run(["git", "show", f":{rel}"], capture_output=True).stdout
    text = blob.decode("utf-8", "ignore").lower()
    n = sum(1 for nd in needles if nd in text)
    if home_path.search(blob):
        n += 1
    if n:
        offenders[rel] = n
if offenders:
    print("pre-commit hook: REFUSED — an absolute home path or a listed name is in the "
          "staged content (file -> matches): " + ", ".join(f"{k} -> {v}" for k, v in offenders.items()),
          file=sys.stderr)
    print("  Remove it, re-stage, commit again.", file=sys.stderr)
    sys.exit(1)
PY
exit 0
